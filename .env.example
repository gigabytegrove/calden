# CalDen works without an .env file.
# Everything below is optional.

# Browser port on the Docker host.
CALDEN_PORT=8787

# Database names normally do not need to be changed.
CALDEN_DB_NAME=calden
CALDEN_DB_USER=calden

# Leave this blank for new installations.
# CalDen automatically creates and persists a random database password.
#
# CALDEN_DB_PASSWORD=
